<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Panel | Sophisticia</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="admin-page">

    <nav class="navbar navbar-expand-lg site-nav sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="/image/Screenshot_2026-09-16_002159-removebg-preview.png" alt="" width="34" height="34">
                Sophisticia
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavigation" aria-controls="adminNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNavigation">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Storefront</a></li>
                    <li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Account</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/logout">Log Out</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-5">

        <div class="text-center">
            <h1>Admin Panel</h1>
            <p class="text-muted">
                Welcome, <%= userName %>
            </p>
            <div class="card shadow-sm p-4 mt-4">
    <h2 class="mb-4">Add New Product</h2>

    <form id="addProductForm">

        <div class="mb-3">
            <label for="productName" class="form-label">Product Name</label>
            <input
                type="text"
                class="form-control"
                id="productName"
                required
            >
        </div>

        <div class="mb-3">
            <label for="productCategory" class="form-label">Category</label>
            <input
                type="text"
                class="form-control"
                id="productCategory"
                required
            >
        </div>

        <div class="mb-3">
            <label for="productPrice" class="form-label">Price</label>
            <input
                type="number"
                class="form-control"
                id="productPrice"
                required
            >
        </div>

        <div class="mb-3">
            <label for="productImage" class="form-label">Image Path</label>
            <input
                type="text"
                class="form-control"
                id="productImage"
                placeholder="/image/product.png"
                required
            >
        </div>

        <div class="mb-3">
            <label for="productDescription" class="form-label">Description</label>
            <textarea
                class="form-control"
                id="productDescription"
                rows="3"
            ></textarea>
        </div>

        <button type="submit" class="btn btn-dark">
            Add Product
        </button>


    </form>

        
<hr class="my-5">

<h2 class="mb-4">Manage Products</h2>
<p class="text-muted">Add, edit, or remove products from your store.</p>

<div id="adminProducts" class="row g-4">
    <!-- Products will appear here -->
</div>

<script>
    async function loadProducts() {
        try {
            const response = await fetch("/api/products");
            const products = await response.json();

            const container = document.getElementById("adminProducts");

            products.forEach(product => {
                container.innerHTML += `
                    <div class="col-md-6 col-lg-4">
                        <div class="card shadow-sm h-100">
<img src="${product.image}" class="card-img-top" style="height: 220px; object-fit: contain;">
                            <div class="card-body">
                                <h5 class="card-title">${product.name}</h5>
                                <p class="text-muted">${product.category}</p>
                                <p>Rs. ${product.price}</p>
                                <div class="mt-3">
                                <button
                                    class="btn btn-sm btn-outline-dark me-2"
                                    onclick="editProduct(${product.id})">
                                    Edit
                                </button>

                                <button
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="deleteProduct(${product.id})">
                                    Delete
                                </button>
                            </div>
                            </div>
                        </div>
                    </div>
                `;
            });

        } catch (error) {
            console.error("Error loading products:", error);
        }
    }

    loadProducts();

    async function deleteProduct(id) {
    const confirmDelete = confirm("Are you sure you want to delete this product?");

    if (!confirmDelete) {
        return;
    }

    try {
        const response = await fetch(`/api/products/${id}`, {
            method: "DELETE"
        });

        const result = await response.json();

        if (result.success) {
            alert(result.message);
            window.location.reload();
        } else {
            alert(result.message);
        }

    } catch (error) {
        console.error("Delete product error:", error);
        alert("Could not delete product.");
    }
}
async function editProduct(id) {
    const newName = prompt("Enter new product name:");
    
    if (newName === null) {
        return;
    }

    const newPrice = prompt("Enter new product price:");

    if (newPrice === null) {
        return;
    }

    try {
        const response = await fetch(`/api/products/${id}`, {
            method: "PUT",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                name: newName,
                price: Number(newPrice)
            })
        });

        const result = await response.json();

        if (result.success) {
            alert(result.message);
            window.location.reload();
        } else {
            alert(result.message);
        }

    } catch (error) {
        console.error("Edit product error:", error);
        alert("Could not edit product.");
    }
}
</script>

</div>
        </div>
<div class="mt-5">
    <hr class="my-5">
    <h2 class="mb-4">Customer Orders</h2>
    <p class="text-muted">View and review orders placed by customers.</p>
    <% if (orders.length === 0) { %>

        <div class="alert alert-info">
            No orders have been placed yet.
        </div>

    <% } else { %>
<!-- a real orders section -->
        <div class="row g-4">

            <% orders.forEach(order => { %>

                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                <%= order.name %>
                            </h5>

                            <p class="mb-1">
                                <strong>Phone:</strong>
                                <%= order.phone %>
                            </p>

                            <p class="mb-1">
                                <strong>City:</strong>
                                <%= order.city %>
                            </p>

                            <p class="mb-1">
                                <strong>Address:</strong>
                                <%= order.address %>
                            </p>

                            <p class="mb-1">
                                <strong>Total:</strong>
                                Rs. <%= order.total %>
                            </p>

                            <p class="text-muted small mt-3">
                                <%= new Date(order.createdAt).toLocaleString() %>
                            </p>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>
<!-- admin.ejs has the three placeholder cards:
Orders | Custom Orders | Products
We're replacing those with the real customer orders. -->
   
<div class="mt-5">
    <hr class="my-5">
    <h2 class="mb-4">Custom Order Requests</h2>
    <p class="text-muted">Review custom requests submitted by customers.</p>
    <% if (customOrders.length === 0) { %>

        <div class="alert alert-info">
            No custom order requests yet.
        </div>

    <% } else { %>

        <div class="row g-4">

            <% customOrders.forEach(customOrder => { %>

                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                <%= customOrder.name %>
                            </h5>

                            <p class="mb-1">
                                <strong>Phone:</strong>
                                <%= customOrder.phone %>
                            </p>

                            <p class="mb-1">
                                <strong>Type:</strong>
                                <%= customOrder.type %>
                            </p>

                            <p class="mb-1">
                                <strong>Description:</strong>
                                <%= customOrder.description %>
                            </p>

                            <p class="mb-1">
                                <strong>Budget:</strong>
                                <%= customOrder.budget || "Not provided" %>
                            </p>

                            <p class="text-muted small mt-3">
                                <%= new Date(customOrder.createdAt).toLocaleString() %>
                            </p>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>

<script>
    const addProductForm = document.getElementById("addProductForm");

    addProductForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        const product = {
            name: document.getElementById("productName").value,
            category: document.getElementById("productCategory").value,
            price: Number(document.getElementById("productPrice").value),
            image: document.getElementById("productImage").value,
            description: document.getElementById("productDescription").value
        };

        try {
            const response = await fetch("/api/products", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(product)
            });

            const result = await response.json();

            if (result.success) {
                alert(result.message);
                addProductForm.reset();
                window.location.reload();
            } else {
                alert(result.message);
            }

        } catch (error) {
            console.error("Add product error:", error);
            alert("Could not add product.");
        }
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>