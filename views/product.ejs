<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= product.name %> | Handmade Art Store</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="product-page">
     <!-- navbar -->
 <nav class="navbar navbar-expand-lg site-nav sticky-top">
  <div class="container">
 <a class="navbar-brand" href="/">
      <img src="/image/Screenshot_2026-09-16_002159-removebg-preview.png" alt="" width="34" height="34" class="d-inline-block align-text-top">
      Sophisticia
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNavigation">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/shop">Shop</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            More Options
          </a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/custom-order">Custom Order</a></li>
            <li><a class="dropdown-item" href="/signup">Log In / Sign Up</a></li>
            <li><a class="dropdown-item" href="/logout">Log Out</a></li>
            
          </ul>
        </li>
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/cart">Cart</a>
        </li>
      </ul>
      <form class="d-flex" role="search">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
        <button class="btn btn-outline-success" type="submit">Search</button>
      </form>
    </div>
  </div>
</nav>

    <div class="container py-5">

        <div class="row align-items-center">

            <!-- Product Image -->
            <div class="col-md-6 product-visual">

                <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
                    class="img-fluid rounded"
                >

            </div>


            <!-- Product Information -->
            <div class="col-md-6 product-details">

                <p class="text-muted product-category">
                    <%= product.category %>
                </p>

                <h1>
                    <%= product.name %>
                </h1>

                <h3 class="mt-3 product-price">
                    Rs. <%= product.price %>
                </h3>

                <p class="mt-4">
                    Beautiful handmade creation crafted with care.
                    Each piece is made to add a unique artistic touch
                    to your collection.
                </p>

                <button
                class="btn btn-dark btn-lg mt-3"
                id="addToCartBtn"
                data-id="<%= product.id %>"
                data-name="<%= product.name %>"
                data-price="<%= product.price %>"
                data-image="<%= product.image %>">
                Add to Cart
            </button>

                <a href="/shop" class="btn btn-outline-dark btn-lg mt-3">
                    Back to Shop
                </a>

            </div>

        </div>

    </div>
<script src="/js/cart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>